# =============================================================================
# Sofia Clinical RAG — Configuración de Secretos para Streamlit Cloud
# =============================================================================
# Copia este contenido en la sección "Secrets" del panel de Streamlit Cloud:
# (En https://share.streamlit.io -> Selecciona la App -> Settings -> Secrets)

# -----------------------------------------------------------------------------
# OPCIÓN RECOMENDADA: Groq Cloud (Gratuito, ultra-rápido y no requiere tener tu PC encendido)
# -----------------------------------------------------------------------------
# 1. Obtén tu clave gratuita en: https://console.groq.com/keys
# 2. Pega tu clave de API:
GROQ_API_KEY = "gsk_tu_clave_de_groq_aqui"
GROQ_MODEL = "qwen/qwen3.8-27b"

# Modelos disponibles y recomendados en Groq:
# - qwen/qwen3.8-27b      (Recomendado: excelente razonamiento clínico y formato estructurado)
# - openai/gpt-oss-120b   (Modelo de alta capacidad)
# - openai/gpt-oss-20b    (Modelo ligero)

# -----------------------------------------------------------------------------
# OPCIÓN ALTERNATIVA: Ollama (Local mediante túnel ngrok o servidor remoto propio)
# -----------------------------------------------------------------------------
# OLLAMA_HOST = "https://tu-tunel-ngrok.ngrok-free.app"
# OLLAMA_MODEL = "qwen3.5:2b-mlx"
