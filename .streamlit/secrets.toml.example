# .streamlit/secrets.toml.example
# Plantilla de secretos para despliegue en Streamlit Community Cloud
# Copia estos valores a Settings -> Secrets en tu panel de Streamlit Cloud.

# Clave de API de Ollama Cloud (generada en https://ollama.com/settings/keys)
OLLAMA_API_KEY = "tu_ollama_api_key_aqui"

# Endpoint de Ollama (por defecto https://ollama.com para Ollama Cloud)
OLLAMA_HOST = "https://ollama.com"

# Modelo LLM a utilizar en la nube (ej: qwen2.5:7b, gemma4:31b, mistral, etc.)
OLLAMA_MODEL = "qwen2.5:7b"
